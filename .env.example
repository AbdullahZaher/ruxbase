# Copy to .env (not committed) and set your own passwords.

# superuser of the development Postgres container (docker-compose.dev.yml)
POSTGRES_USER=admin
POSTGRES_PASSWORD=

# password of the non-superuser role ruxbase_app (scripts/ci-db-setup.sql)
APP_PASSWORD=

# main database of "go run ./examples/base serve"
# DATABASE_URL=postgres://admin:<postgres-password>@localhost:5433/ruxbase?sslmode=disable

# template database of the tests
# RUXBASE_TEST_URL=postgres://ruxbase_app:<app-password>@localhost:5433/ruxbase_test?sslmode=disable
