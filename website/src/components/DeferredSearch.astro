---
import { SITE_BASE } from '../../scripts/site-config.mjs';
---
<site-search data-base={SITE_BASE}>
  <button type="button" data-open-modal disabled aria-label="Search" aria-keyshortcuts="Control+K" aria-haspopup="dialog">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
    <span class="search-label" aria-hidden="true">Search</span>
    <kbd class="search-shortcut" aria-hidden="true">Ctrl K</kbd>
  </button>
  <dialog aria-label="Search documentation">
    <div class="search-frame">
      <button type="button" data-close-modal autofocus>Close</button>
      <p data-search-status role="status" aria-live="polite" hidden></p>
      <button type="button" data-search-retry hidden>Retry search</button>
      <div id="starlight__search"></div>
    </div>
  </dialog>
  <noscript><a href={SITE_BASE + 'llms.txt'}>Documentation index</a></noscript>
</site-search>

<script>
  import '../scripts/deferred-search.mjs';
</script>

<style>
  site-search { display: contents; }
  [data-open-modal] {
    display: flex; align-items: center; gap: .5rem; height: 2.5rem;
    border: 0; background: transparent; color: var(--sl-color-gray-1);
    cursor: pointer; padding: .25rem;
  }
  .search-label, .search-shortcut { display: none; }
  [data-open-modal]:focus-visible, [data-close-modal]:focus-visible, [data-search-retry]:focus-visible {
    outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px;
  }
  dialog {
    color: var(--sl-color-text); background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5); padding: 0;
    width: 100%; max-width: 100%; height: 100%; max-height: 100%;
    margin: 0; box-shadow: var(--sl-shadow-lg);
  }
  dialog[open] { display: flex; }
  dialog::backdrop { background: var(--sl-color-backdrop-overlay); backdrop-filter: blur(.25rem); }
  .search-frame { flex: 1; min-width: 0; overflow: auto; padding: 1rem; }
  [data-close-modal], [data-search-retry] {
    display: block; margin: 0 0 .75rem auto; padding: .25rem .75rem;
    color: var(--sl-color-text-accent); border: 1px solid var(--sl-color-gray-4);
    border-radius: .25rem; background: transparent; cursor: pointer;
  }
  [hidden] { display: none !important; }
  #starlight__search {
    --pagefind-ui-primary: var(--sl-color-text);
    --pagefind-ui-text: var(--sl-color-gray-2);
    --pagefind-ui-background: var(--sl-color-black);
    --pagefind-ui-border: var(--sl-color-gray-5);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-tag: var(--sl-color-gray-5);
    --pagefind-ui-font: var(--__sl-font);
    --pagefind-ui-scale: .9;
  }
  @media (min-width: 50rem) {
    [data-open-modal] {
      width: 100%; max-width: 22rem; min-width: 12rem;
      border: 1px solid var(--sl-color-gray-5); border-radius: .5rem;
      padding-inline: .75rem .5rem; background: var(--sl-color-black);
      color: var(--sl-color-gray-2); font-size: var(--sl-text-sm);
    }
    .search-label, .search-shortcut { display: inline; }
    .search-shortcut {
      margin-inline-start: auto; padding-inline: .375rem; border-radius: .25rem;
      background: var(--sl-color-gray-6); font-family: var(--__sl-font); font-size: var(--sl-text-2xs);
    }
    dialog { width: 90%; max-width: 40rem; height: max-content; min-height: 15rem; max-height: calc(100% - 8rem); margin: 4rem auto auto; border-radius: .5rem; }
    .search-frame { padding: 1.5rem; }
  }
</style>
