{
  "name": "ruxbase-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test:foundation": "node --test tests/foundation.test.mjs tests/legacy-links.test.mjs tests/release-artifact.test.mjs",
    "dev": "node scripts/prepare.mjs && astro dev",
    "build": "node scripts/prepare.mjs && astro build && node scripts/export-ai.mjs && node scripts/export-references.mjs && bash scripts/stage-scalar-candidate.sh && node scripts/release-artifact.mjs seal",
    "preview": "astro preview",
    "prepare:docs": "node scripts/prepare.mjs",
    "test:ai": "node --test tests/ai.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13",
    "hast-util-from-html": "2.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  }
}
